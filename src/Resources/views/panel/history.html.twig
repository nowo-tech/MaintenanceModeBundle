{#
  Maintenance history (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from
  MaintenancePages::history(): columns occurredAt, action, actor, message; in-memory Pagination over the last
  web_ui.history_limit entries; EmptyState; area nav Panel | History), and the 1.x variables entries, path_prefix.
  Data blocks filled: nowo_ui_list_row.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoMaintenanceModeBundle' %}

{% block nowo_ui_flashes %}
    {{ include(nowo_ui_partial('flashes', page.bundle), {bundle: page.bundle, trans_domain: 'NowoMaintenanceModeBundle', flashes: null}) }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% set _muted = _cell ~ ' ' ~ nowo_ui_class('table_cell_muted', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'panel.history.when'|trans }}"><time datetime="{{ row.occurredAt|date('c') }}">{{ row.occurredAt|date('Y-m-d H:i:s') }}</time></td>
    <td class="{{ _cell }}" data-label="{{ 'panel.history.action'|trans }}"><span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ row.action }}</span></td>
    <td class="{{ row.actor ? _cell : _muted }}" data-label="{{ 'panel.history.actor'|trans }}" data-nowo-ui-priority="2">{{ row.actor ?: '—' }}</td>
    <td class="{{ row.message ? _cell : _muted }}" data-label="{{ 'panel.history.message'|trans }}" data-nowo-ui-priority="3">{{ row.message ?: '—' }}</td>
{% endblock %}
