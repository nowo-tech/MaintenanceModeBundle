{% extends '@NowoMaintenanceModeBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_maintenance_mode_css_framework|default('custom') %}
{% set _td = 'NowoMaintenanceModeBundle' %}
{# Admin chrome hooks (1.7.0): web_ui.classes / partials / show_page_header / test_ids + maintenance_* blocks. #}
{% set _chrome = nowo_maintenance_mode_chrome %}
{% set _cls = _chrome.classes %}
{% set _partials = _chrome.partials %}

{% block title %}{% if _chrome.document_title %}{{ 'panel.title'|trans({}, _td) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block body %}
    {% block maintenance_nav %}{{ include(_partials.nav, {active: 'panel', path_prefix: path_prefix}) }}{% endblock %}
    {%~ block maintenance_page_header %}
    {%~ if _chrome.show_page_header %}
    <header{% if _cls.page_header %} class="{{ _cls.page_header }}"{% endif %}>
        <h1{% if _cls.page_title %} class="{{ _cls.page_title }}"{% endif %}>{% block maintenance_page_title %}{{ 'panel.title'|trans({}, _td) }}{% endblock %}</h1>
        {%~ block maintenance_page_intro %}{% endblock %}
        {%~ block maintenance_header_actions %}{% endblock %}
    </header>
    {%~ endif %}
    {%~ endblock %}

    {%~ block maintenance_flashes %}
    {% for type, messages in flashes|default({}) %}
        {% for message in messages %}
            <div class="{{ ui.flash(type, _css_fw) }}{{ _cls.flash ? ' ' ~ _cls.flash }}" role="alert">{{ message|trans({}, _td) }}</div>
        {% endfor %}
    {% endfor %}
    {%~ endblock %}

    {%~ block maintenance_status %}
    <p{% if _cls.status_line %} class="{{ _cls.status_line }}"{% endif %}{% if _chrome.test_ids %} data-testid="maintenance-status"{% endif %}>
        {{ 'panel.status.manual'|trans({}, _td) }}:
        {% if state.enabled %}
            <span class="{{ _cls.status_on }}">{{ 'panel.status.enabled'|trans({}, _td) }}</span>
        {% else %}
            <span class="{{ _cls.status_off }}">{{ 'panel.status.disabled'|trans({}, _td) }}</span>
        {% endif %}
        ·
        {{ 'panel.status.effective'|trans({}, _td) }}:
        {% if state.effectivelyEnabled %}
            <span class="{{ _cls.status_on }}">{{ 'panel.status.on'|trans({}, _td) }}</span>
        {% else %}
            <span class="{{ _cls.status_off }}">{{ 'panel.status.off'|trans({}, _td) }}</span>
        {% endif %}
    </p>
    {%~ endblock %}

    {%~ block maintenance_state_details %}
    <div{% if _cls.card %} class="{{ _cls.card }}"{% endif %}>
        <p><strong>{{ 'panel.message'|trans({}, _td) }}:</strong> {{ state.message ?? '—' }}</p>
        <p><strong>{{ 'panel.activated'|trans({}, _td) }}:</strong> {{ state.activatedAt ? state.activatedAt|date('Y-m-d H:i:s') : '—' }}</p>
        <p><strong>{{ 'panel.deactivated'|trans({}, _td) }}:</strong> {{ state.deactivatedAt ? state.deactivatedAt|date('Y-m-d H:i:s') : '—' }}</p>
        <p><strong>{{ 'panel.scheduled_enable'|trans({}, _td) }}:</strong> {{ state.scheduledEnableAt ? state.scheduledEnableAt|date('Y-m-d H:i:s') : '—' }}</p>
        <p><strong>{{ 'panel.scheduled_disable'|trans({}, _td) }}:</strong> {{ state.scheduledDisableAt ? state.scheduledDisableAt|date('Y-m-d H:i:s') : '—' }}</p>
        <p><strong>{{ 'panel.updated_by'|trans({}, _td) }}:</strong> {{ state.updatedBy ?? '—' }}</p>
    </div>
    {%~ endblock %}

    {%~ block maintenance_manual_forms %}
    <div{% if _cls.card %} class="{{ _cls.card }}"{% endif %}{% if _chrome.test_ids %} data-testid="maintenance-manual"{% endif %}>
        {{ form_start(enable_form, _cls.form ? {attr: {class: _cls.form}} : {}) }}
            {{ include(_partials.form_fields, {form: enable_form}, false) }}
            {%~ if _cls.form_actions %}<div class="{{ _cls.form_actions }}">{% endif %}
            <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }}">{{ 'panel.enable'|trans({}, _td) }}</button>
            {%~ if _cls.form_actions %}</div>{% endif %}
        {{ form_end(enable_form) }}
        {{ form_start(disable_form, {attr: {style: 'margin-top:1rem'}|merge(_cls.form ? {class: _cls.form} : {})}) }}
            {{ include(_partials.form_fields, {form: disable_form}, false) }}
            {%~ if _cls.form_actions %}<div class="{{ _cls.form_actions }}">{% endif %}
            <button type="submit" class="{{ ui.btn('danger', null, _css_fw) }}">{{ 'panel.disable'|trans({}, _td) }}</button>
            {%~ if _cls.form_actions %}</div>{% endif %}
        {{ form_end(disable_form) }}
    </div>
    {%~ endblock %}

    {%~ block maintenance_schedule_forms %}
    <div{% if _cls.card %} class="{{ _cls.card }}"{% endif %}{% if _chrome.test_ids %} data-testid="maintenance-schedule"{% endif %}>
        <h2{% if _cls.section_title %} class="{{ _cls.section_title }}"{% endif %}>{{ 'panel.schedule'|trans({}, _td) }}</h2>
        {{ form_start(schedule_form, _cls.form ? {attr: {class: _cls.form}} : {}) }}
            {{ include(_partials.form_fields, {form: schedule_form}, false) }}
            {%~ if _cls.form_actions %}<div class="{{ _cls.form_actions }}">{% endif %}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'panel.save_schedule'|trans({}, _td) }}</button>
            {%~ if _cls.form_actions %}</div>{% endif %}
        {{ form_end(schedule_form) }}
        {{ form_start(clear_schedule_form, {attr: {style: 'margin-top:1rem'}|merge(_cls.form ? {class: _cls.form} : {})}) }}
            {{ include(_partials.form_fields, {form: clear_schedule_form}, false) }}
            {%~ if _cls.form_actions %}<div class="{{ _cls.form_actions }}">{% endif %}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'panel.clear_schedule'|trans({}, _td) }}</button>
            {%~ if _cls.form_actions %}</div>{% endif %}
        {{ form_end(clear_schedule_form) }}
    </div>
    {%~ endblock %}

    {%~ block maintenance_logout_form %}
    {% if password_required ?? true %}
        {{ form_start(logout_form, {attr: {style: 'margin-top:1.5rem'}}) }}
            {{ include(_partials.form_fields, {form: logout_form}, false) }}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'panel.logout'|trans({}, _td) }}</button>
        {{ form_end(logout_form) }}
    {% endif %}
    {%~ endblock %}
{% endblock %}
