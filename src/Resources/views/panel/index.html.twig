{#
  Maintenance panel (REQ-UI-003): UiKit settings scaffold. Variables: page (View\SettingsPage from
  MaintenancePages::panel(): sections status, manual, schedule; header action Logout when the password gate is on;
  area nav Panel | History in page.header.tabs; the manual / schedule sections carry their Disable / Clear schedule
  actions as SettingsSection::actions, printed by the scaffold after the section form), section_actions (BC, 1.10:
  the same actions keyed by section id), status_items (list<View\DetailItem>), and the 1.x variables state,
  path_prefix, password_required, flashes, enable_form, disable_form, schedule_form, clear_schedule_form, logout_form.
  Data block filled: nowo_ui_settings_section.
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoMaintenanceModeBundle' %}

{% block nowo_ui_flashes %}
    {#- UiKit 2.2: the 1.x context variable `flashes` (peeked) no longer shadows app.flashes inside page scaffolds -#}
    {{ include(nowo_ui_partial('flashes', page.bundle), {bundle: page.bundle, trans_domain: 'NowoMaintenanceModeBundle'}) }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    <div data-testid="maintenance-{{ section.id }}">
        {% if section.id == 'status' %}
            <p class="{{ nowo_ui_class('toolbar', _b) }}">
                <span>{{ 'panel.status.manual'|trans }}:</span>
                <span class="{{ nowo_ui_class(state.enabled ? 'badge_warning' : 'badge_success', _b) }}" data-testid="maintenance-status-manual">{{ (state.enabled ? 'panel.status.enabled' : 'panel.status.disabled')|trans }}</span>
                <span>{{ 'panel.status.effective'|trans }}:</span>
                <span class="{{ nowo_ui_class(state.effectivelyEnabled ? 'badge_warning' : 'badge_success', _b) }}" data-testid="maintenance-status-effective">{{ (state.effectivelyEnabled ? 'panel.status.on' : 'panel.status.off')|trans }}</span>
            </p>
            {{ include(nowo_ui_partial('detail_list', _b), {items: status_items, bundle: _b}, false) }}
        {% else %}
            {#- section form + its actions row (SettingsSection::actions, UiKit 2.2: Disable / Clear schedule) -#}
            {{ parent() }}
        {% endif %}
    </div>
{% endblock %}
