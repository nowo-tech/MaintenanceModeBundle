{# Panel pages extend this shell; configure web_ui.layout_template for host chrome (REQ-UI-001).
   Controller may pass `layout`; otherwise Twig global nowo_maintenance_mode_layout_template is used. #}
{% extends layout|default(nowo_maintenance_mode_layout_template|default('@NowoMaintenanceModeBundle/panel/layout.html.twig')) %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_maintenance_mode_css_framework|default('custom') %}

{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}{% endblock %}
{% endblock %}
