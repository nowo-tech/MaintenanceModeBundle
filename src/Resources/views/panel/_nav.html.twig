{# Panel / History navigation (web_ui.partials.nav). Receives: active ('panel'|'history'), path_prefix.
   Classes: web_ui.classes.nav / nav_link. Alternative: @NowoMaintenanceModeBundle/panel/_nav_tabs.html.twig (UiKit tabs).
   Indentation mirrors the pre-1.7.0 inline markup so default output stays byte-identical. #}
{% set _chrome = nowo_maintenance_mode_chrome %}
{% set _cls = _chrome.classes %}
{% set _td = 'NowoMaintenanceModeBundle' %}
<nav{% if _cls.nav %} class="{{ _cls.nav }}"{% endif %} aria-label="{{ 'panel.nav.aria_label'|trans({}, _td) }}"{% if _chrome.test_ids %} data-testid="maintenance-panel-tabs"{% endif %}>
        <a{% if _cls.nav_link %} class="{{ _cls.nav_link }}"{% endif %} href="{{ path_prefix }}">{{ 'panel.nav.panel'|trans({}, _td) }}</a>
        <a{% if _cls.nav_link %} class="{{ _cls.nav_link }}"{% endif %} href="{{ path_prefix }}/history">{{ 'panel.nav.history'|trans({}, _td) }}</a>
    </nav>
