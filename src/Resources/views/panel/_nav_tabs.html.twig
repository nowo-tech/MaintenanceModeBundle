{# Opt-in Panel / History tabs built on UiKit partials/_tabs (ui.tab_list / ui.tab_item honour web_ui.css_framework).
   Enable with web_ui.partials.nav: '@NowoMaintenanceModeBundle/panel/_nav_tabs.html.twig'. Receives: active, path_prefix. #}
{% set _td = 'NowoMaintenanceModeBundle' %}
{% set _on_history = active|default('') == 'history' %}
{{ include('@NowoUiKitBundle/partials/_tabs.html.twig', {
    aria_label: 'panel.nav.aria_label'|trans({}, _td),
    framework: nowo_maintenance_mode_css_framework|default('custom'),
    items: [
        {label: 'panel.nav.panel'|trans({}, _td), href: path_prefix, current: not _on_history},
        {label: 'panel.nav.history'|trans({}, _td), href: path_prefix ~ '/history', current: _on_history},
    ],
}, false) }}
