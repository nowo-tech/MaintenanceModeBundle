{% extends '@NowoMaintenanceModeBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_maintenance_mode_css_framework|default('custom') %}

{% block title %}{{ 'panel.login.heading'|trans({}, 'NowoMaintenanceModeBundle') }}{% endblock %}

{% block body %}
    <header class="nowo-ui-page-header">
        <h1>{{ 'panel.login.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
    </header>
    <p>{{ 'panel.login.intro'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    {% if error %}
        <p class="nowo-ui-error error">{{ 'panel.login.error'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    {% endif %}
    <div class="nowo-ui-card card">
        <form method="post" action="{{ path_prefix }}/login">
            <input type="hidden" name="_token" value="{{ csrf_token('nowo_maintenance_login') }}">
            <label for="password">{{ 'panel.login.password'|trans({}, 'NowoMaintenanceModeBundle') }}</label>
            <input type="password" id="password" name="password" required autocomplete="current-password">
            <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }}">{{ 'panel.login.submit'|trans({}, 'NowoMaintenanceModeBundle') }}</button>
        </form>
    </div>
{% endblock %}
