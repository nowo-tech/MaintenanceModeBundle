<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.page.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #1c2430;
            --muted: #4a5564;
            --card: rgba(255, 255, 255, 0.78);
            --accent: #2f6f6a;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1.5rem;
            font-family: "Source Sans 3", system-ui, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(ellipse 80% 60% at 20% 10%, #d7efe9 0%, transparent 55%),
                radial-gradient(ellipse 70% 50% at 90% 85%, #e8f0d8 0%, transparent 50%),
                linear-gradient(165deg, #f7faf8, #eef3f1 45%, #e7eee9);
        }
        main {
            width: min(100%, 34rem);
            padding: 2.25rem 2rem;
            border-radius: 1.35rem;
            background: var(--card);
            backdrop-filter: blur(10px);
            box-shadow: 0 18px 50px rgba(28, 36, 48, 0.08);
            text-align: center;
        }
        .badge {
            display: inline-block;
            margin-bottom: 1rem;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            background: rgba(47, 111, 106, 0.12);
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.02em;
        }
        h1 {
            font-family: Fraunces, Georgia, serif;
            font-size: clamp(1.85rem, 4vw, 2.55rem);
            font-weight: 700;
            line-height: 1.15;
            margin: 0 0 0.85rem;
        }
        .message {
            margin: 0 0 1rem;
            color: var(--muted);
            font-size: 1.08rem;
            line-height: 1.65;
        }
        .reassure, .thanks {
            margin: 0;
            color: #5b6572;
            font-size: 0.98rem;
            line-height: 1.55;
        }
        .thanks { margin-top: 0.75rem; color: var(--accent); font-weight: 600; }
    </style>
</head>
<body>
<main>
    <p class="badge">{{ 'maintenance.page.badge'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    <h1>{{ 'maintenance.page.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
    <p class="message">{{ message|default('maintenance.page.message'|trans({}, 'NowoMaintenanceModeBundle')) }}</p>
    <p class="reassure">{{ 'maintenance.page.reassure'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    <p class="thanks">{{ 'maintenance.page.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
</main>
</body>
</html>
