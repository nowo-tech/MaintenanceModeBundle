{#
  Public maintenance page (503 and the dev preview) — REQ-UI-003 unique page on the guest layout
  (page.layout ?? nowo_ui_layout.guest), painted by the UiKit theme slots and --nowo-ui-* tokens. No CDN, no inline
  styles, no JavaScript (the UiKit scripts are not loaded: nowo_ui_scripts only holds maintenance_scripts, and the
  layout's pre-paint theme boot is skipped with nowo_ui_theme_boot = false), no
  flashes (the 503 never reads or starts the session). Rendered by MaintenanceRequestSubscriber before the firewall:
  keep host overrides free of database, session and security calls.

  Variables: message (string|null, the state message), state (MaintenanceState), page (View\AuthPage from
  MaintenancePages::maintenance(): title, brand, intro = message, bundle, layout) — all optional except state.
  Hooks (1.7.0): set templates.page to a host template that extends this one and overrides the maintenance_* blocks
  (head, fonts, styles, head_extra, body, brand, heading, message, reassure, footer, scripts), or that extends
  @NowoUiKit/page/auth.html.twig with `page`. maintenance_html_attributes / maintenance_body_attributes are no longer
  rendered (the document layout owns <html> and <body>; use theme.attributes.document / body).
#}
{% extends (page ?? null) and page.layout ? page.layout : nowo_ui_layout.guest %}
{% trans_default_domain 'NowoMaintenanceModeBundle' %}
{% set nowo_ui_bundle = (page ?? null) ? page.bundle : 'NowoMaintenanceModeBundle' %}
{% set nowo_ui_page_type = 'auth' %}
{# No JavaScript at all on the 503: no UiKit runtime nor pre-paint theme boot (UiKit 2.2 nowo_ui_scripts_enabled, set
   from AuthPage::scripts = false); nowo_ui_theme_boot = false kept for host guest layouts that only read that flag. #}
{% set nowo_ui_scripts_enabled = (page ?? null) ? page.scripts : false %}
{% set nowo_ui_theme_boot = false %}

{% block nowo_ui_document_title %}{% block title %}{{ 'maintenance.page.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    <meta name="robots" content="noindex">
    {%~ block maintenance_head %}
    {%~ block maintenance_fonts %}{% endblock %}
    {%~ block maintenance_styles %}{% endblock %}
    {%~ endblock %}
    {%~ block maintenance_head_extra %}{% endblock %}
{% endblock %}

{% block nowo_ui_flashes %}{% endblock %}

{% block nowo_ui_content %}
    {% set _b = nowo_ui_bundle %}
    {%~ block maintenance_body %}
    <section class="{{ nowo_ui_class('auth_panel', _b) }} nowo-maintenance-page" data-nowo-ui-page="maintenance" data-nowo-ui-region="panel" data-testid="maintenance-page"{{ nowo_ui_attrs('auth_panel', _b) }}>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {%~ block maintenance_brand %}
            <p class="nowo-ui-auth-panel__brand"><span class="{{ nowo_ui_class('badge_info', _b) }}">{{ 'maintenance.page.badge'|trans }}</span></p>
            {%~ endblock %}
            {%~ block maintenance_heading %}
            <h1 class="{{ nowo_ui_class('page_title', _b) }}">{{ 'maintenance.page.heading'|trans }}</h1>
            {%~ endblock %}
            {%~ block maintenance_message %}
            <p class="{{ nowo_ui_class('page_intro', _b) }}">{{ message|default('maintenance.page.message'|trans) }}</p>
            {%~ endblock %}
            {%~ block maintenance_reassure %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'maintenance.page.reassure'|trans }}</p>
            {%~ endblock %}
        </div>
        <footer class="{{ nowo_ui_class('auth_footer', _b) }}">
            {%~ block maintenance_footer %}
            <p>{{ 'maintenance.page.thanks'|trans }}</p>
            {%~ endblock %}
        </footer>
    </section>
    {%~ endblock %}
{% endblock %}

{% block nowo_ui_scripts %}
    {%~ block maintenance_scripts %}{% endblock %}
{% endblock %}
