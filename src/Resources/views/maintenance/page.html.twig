<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'maintenance.page.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <style>
        body {
            margin: 0; min-height: 100vh; display: grid; place-items: center;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: radial-gradient(circle at top, #dfe8ff, #f4f1ea 55%, #e7ebe7);
            color: #1a1a1a;
        }
        main { max-width: 36rem; padding: 2rem; text-align: center; }
        h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: .75rem; }
        p { color: #444; line-height: 1.6; font-size: 1.05rem; }
    </style>
</head>
<body>
<main>
    <h1>{{ 'maintenance.page.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
    <p>{{ message|default('maintenance.page.message'|trans({}, 'NowoMaintenanceModeBundle')) }}</p>
</main>
</body>
</html>
