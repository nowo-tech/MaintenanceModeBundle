{# Idea 1 — Short & sweet (inspired by concise brand pauses)
   Config: templates.page: '@NowoMaintenanceModeBundle/maintenance/examples/idea_short.html.twig'
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.examples.idea_short.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        body { min-height: 100vh; font-family: "IBM Plex Sans", system-ui, sans-serif; background: #f4f6f8; color: #1a1f26; }
        .mm-wrap { min-height: 100vh; }
        .mm-mark { width: 3rem; height: 3rem; border-radius: 50%; background: #1a1f26; color: #fff; display: grid; place-items: center; font-weight: 700; letter-spacing: -0.04em; }
        .mm-lead { font-size: 1.15rem; color: #4b5563; max-width: 22rem; margin-inline: auto; }
    </style>
</head>
<body>
<div class="mm-wrap d-flex align-items-center justify-content-center px-3 py-5">
    <div class="text-center" style="max-width: 26rem;">
        <div class="d-flex justify-content-center mb-4"><div class="mm-mark" aria-hidden="true">BR</div></div>
        <p class="text-uppercase small fw-semibold text-secondary mb-2 tracking-wide">{{ 'maintenance.examples.idea_short.eyebrow'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
        <h1 class="h3 fw-bold mb-3">{{ 'maintenance.examples.idea_short.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
        <p class="mm-lead mb-3">{{ message|default('maintenance.examples.idea_short.message'|trans({}, 'NowoMaintenanceModeBundle')) }}</p>
        <p class="text-secondary small mb-0">{{ 'maintenance.examples.idea_short.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    </div>
</div>
</body>
</html>
