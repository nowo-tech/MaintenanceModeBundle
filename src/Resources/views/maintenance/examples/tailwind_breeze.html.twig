{# Example: Tailwind CSS 4 — light breeze / mint sky
   Config: templates.page: '@NowoMaintenanceModeBundle/maintenance/examples/tailwind_breeze.html.twig'
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.examples.tailwind_breeze.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Newsreader:opsz,wght@6..72,600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @theme {
            --font-sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
            --font-display: "Newsreader", ui-serif, Georgia, serif;
            --color-breeze-50: #f3fbf8;
            --color-breeze-100: #dff5ec;
            --color-breeze-700: #1f6b5c;
            --color-breeze-900: #163a34;
        }
    </style>
</head>
<body class="min-h-screen font-sans text-breeze-900 bg-[radial-gradient(ellipse_at_top,_var(--color-breeze-100),_transparent_55%),linear-gradient(180deg,#f7fcfa,#eaf6f1)]">
<main class="min-h-screen grid place-items-center px-4 py-10">
    <section class="w-full max-w-lg rounded-3xl bg-white/85 backdrop-blur-md shadow-[0_20px_50px_rgba(22,58,52,0.08)] border border-breeze-100 px-8 py-10 text-center">
        <p class="inline-flex items-center rounded-full bg-breeze-100 px-3 py-1 text-sm font-semibold text-breeze-700 mb-4">
            {{ 'maintenance.examples.tailwind_breeze.eyebrow'|trans({}, 'NowoMaintenanceModeBundle') }}
        </p>
        <h1 class="font-[family-name:var(--font-display)] text-4xl leading-tight tracking-tight mb-4">
            {{ 'maintenance.examples.tailwind_breeze.heading'|trans({}, 'NowoMaintenanceModeBundle') }}
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">
            {{ message|default('maintenance.examples.tailwind_breeze.message'|trans({}, 'NowoMaintenanceModeBundle')) }}
        </p>
        <p class="text-slate-500 leading-relaxed mb-3">
            {{ 'maintenance.examples.tailwind_breeze.reassure'|trans({}, 'NowoMaintenanceModeBundle') }}
        </p>
        <p class="font-semibold text-breeze-700">
            {{ 'maintenance.examples.tailwind_breeze.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}
        </p>
    </section>
</main>
</body>
</html>
