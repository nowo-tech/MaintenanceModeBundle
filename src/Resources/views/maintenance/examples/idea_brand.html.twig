{# Idea 4 — Familiar brand look (logo mark + restrained palette)
   Config: templates.page: '@NowoMaintenanceModeBundle/maintenance/examples/idea_brand.html.twig'
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.examples.idea_brand.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root { --ink: #111; --muted: #6e6e73; --line: #d2d2d7; --bg: #f5f5f7; }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem;
            font-family: Inter, "Helvetica Neue", Arial, sans-serif; color: var(--ink); background: var(--bg);
        }
        main { width: min(100%, 28rem); text-align: center; }
        .mark {
            width: 3.5rem; height: 3.5rem; margin: 0 auto 1.5rem; border-radius: 22%;
            background: linear-gradient(160deg, #2c2c2e, #111); color: #fff;
            display: grid; place-items: center; font-weight: 600; font-size: 1.15rem; letter-spacing: -0.03em;
            box-shadow: 0 10px 30px rgba(0,0,0,.18);
        }
        h1 { font-size: 1.65rem; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 .85rem; }
        p { margin: 0 0 .85rem; line-height: 1.55; color: var(--muted); }
        .thanks { color: var(--ink); font-weight: 500; margin-top: 1.25rem; }
        .rule { width: 3rem; height: 1px; background: var(--line); margin: 1.25rem auto; }
    </style>
</head>
<body>
<main>
    <div class="mark" aria-hidden="true">{{ 'maintenance.examples.idea_brand.mark'|trans({}, 'NowoMaintenanceModeBundle') }}</div>
    <p style="font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:#86868b;">
        {{ 'maintenance.examples.idea_brand.eyebrow'|trans({}, 'NowoMaintenanceModeBundle') }}
    </p>
    <h1>{{ 'maintenance.examples.idea_brand.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
    <div class="rule"></div>
    <p>{{ message|default('maintenance.examples.idea_brand.message'|trans({}, 'NowoMaintenanceModeBundle')) }}</p>
    <p>{{ 'maintenance.examples.idea_brand.reassure'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
    <p class="thanks">{{ 'maintenance.examples.idea_brand.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
</main>
</body>
</html>
