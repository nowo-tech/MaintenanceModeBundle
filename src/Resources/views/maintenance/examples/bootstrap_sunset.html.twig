{# Example: Bootstrap 5.3 — warm sunset / peach tone
   Config: templates.page: '@NowoMaintenanceModeBundle/maintenance/examples/bootstrap_sunset.html.twig'
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.examples.bootstrap_sunset.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;700&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        body {
            min-height: 100vh;
            font-family: Manrope, system-ui, sans-serif;
            background:
                radial-gradient(circle at 15% 20%, rgba(255, 196, 140, 0.55), transparent 42%),
                radial-gradient(circle at 85% 80%, rgba(255, 168, 168, 0.35), transparent 40%),
                linear-gradient(180deg, #fff7ef, #ffe8d6);
        }
        .mm-shell { min-height: 100vh; }
        .mm-panel {
            border-radius: 1.75rem;
            background: rgba(255, 252, 248, 0.9);
            border: 1px solid rgba(214, 140, 90, 0.18);
            box-shadow: 0 1.25rem 2.75rem rgba(120, 70, 40, 0.08);
        }
        h1 { font-family: Literata, Georgia, serif; color: #5a3a28; }
        .mm-accent { color: #b65c2e; }
        .mm-copy { color: #6d5345; }
    </style>
</head>
<body>
<div class="mm-shell d-flex align-items-center py-5">
    <div class="container" style="max-width: 36rem;">
        <div class="mm-panel p-4 p-md-5 text-center">
            <p class="small text-uppercase fw-semibold mm-accent mb-2 letter-spacing">
                {{ 'maintenance.examples.bootstrap_sunset.eyebrow'|trans({}, 'NowoMaintenanceModeBundle') }}
            </p>
            <h1 class="display-6 fw-bold mb-3">{{ 'maintenance.examples.bootstrap_sunset.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
            <p class="fs-5 mm-copy mb-3">
                {{ message|default('maintenance.examples.bootstrap_sunset.message'|trans({}, 'NowoMaintenanceModeBundle')) }}
            </p>
            <hr class="border-warning-subtle my-4 opacity-50">
            <p class="mm-copy mb-2">{{ 'maintenance.examples.bootstrap_sunset.reassure'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
            <p class="fw-bold mm-accent mb-0">{{ 'maintenance.examples.bootstrap_sunset.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
        </div>
    </div>
</div>
</body>
</html>
