{# Idea 2 — Compassionate (apology + reassurance; no panel login links)
   Config: templates.page: '@NowoMaintenanceModeBundle/maintenance/examples/idea_compassion.html.twig'
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'maintenance.examples.idea_compassion.title'|trans({}, 'NowoMaintenanceModeBundle') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        body { min-height: 100vh; font-family: "Source Sans 3", system-ui, sans-serif; background: linear-gradient(180deg, #f7f4ef, #ebe6de); color: #2c241c; }
        h1 { font-family: "Source Serif 4", Georgia, serif; }
        .mm-card { background: rgba(255,255,255,.9); border: 1px solid #e4ddd2; border-radius: 1.25rem; box-shadow: 0 12px 40px rgba(44,36,28,.06); }
        .mm-note { background: #f3eee6; border-radius: .85rem; color: #5a4e42; }
    </style>
</head>
<body>
<div class="min-vh-100 d-flex align-items-center py-5 px-3">
    <div class="container" style="max-width: 36rem;">
        <div class="mm-card p-4 p-md-5">
            <p class="badge text-bg-warning-subtle text-warning-emphasis mb-3">{{ 'maintenance.examples.idea_compassion.eyebrow'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
            <h1 class="h2 mb-3">{{ 'maintenance.examples.idea_compassion.heading'|trans({}, 'NowoMaintenanceModeBundle') }}</h1>
            <p class="fs-5 mb-3">{{ message|default('maintenance.examples.idea_compassion.message'|trans({}, 'NowoMaintenanceModeBundle')) }}</p>
            <p class="text-secondary mb-4">{{ 'maintenance.examples.idea_compassion.reassure'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
            <div class="mm-note p-3 mb-4 small">{{ 'maintenance.examples.idea_compassion.status_note'|trans({}, 'NowoMaintenanceModeBundle') }}</div>
            <p class="fw-semibold mb-0">{{ 'maintenance.examples.idea_compassion.thanks'|trans({}, 'NowoMaintenanceModeBundle') }}</p>
        </div>
    </div>
</div>
</body>
</html>
