{% extends 'base.html.twig' %}

{% block title %}Maintenance page examples{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Maintenance page examples',
        intro: 'Calm, anxiety-light 503 templates shipped with the bundle. Frameworks: Bootstrap 5.3, Foundation 6.9, Tailwind CSS 4, plus vanilla CSS. Patterns: soft themes + six idea pages (short, compassionate, playful, brand, countdown, updates). Locales: en · es · it · fr · pt · de · nl.',
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
        <table class="nowo-ui-data-table">
            <thead>
            <tr>
                <th>Slug</th>
                <th>Framework</th>
                <th>Style</th>
                <th>Preview</th>
            </tr>
            </thead>
            <tbody>
            {% for slug, meta in examples %}
                <tr>
                    <td><code>{{ slug }}</code></td>
                    <td>{{ meta.framework }}</td>
                    <td>{{ meta.style }}</td>
                    <td>
                        {% for loc in locales %}
                            <a class="nowo-ui-link" href="{{ path('maintenance_example_show', {slug: slug, _locale: loc}) }}">{{ loc }}</a>{% if not loop.last %} · {% endif %}
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </section>

    <p><a class="nowo-ui-link" href="{{ path('homepage') }}">← Demo home</a></p>
{% endblock %}
