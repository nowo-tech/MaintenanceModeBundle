<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}"{% block html_attributes %}{% endblock %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Maintenance Mode Demo{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/demo.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="demo-masthead">
    <a class="demo-brand" href="/">Maintenance Mode <span>Demo</span></a>
    {% block masthead_nav %}
        <nav aria-label="Demo">
            <a href="/">Home</a>
            <a href="/_maintenance/">Admin panel</a>
            <a href="/_maintenance/history">History</a>
            <a href="/_maintenance_preview">503 preview</a>
            <a href="/examples">Sample pages</a>
        </nav>
    {% endblock %}
</header>
<main class="{% block main_class %}{% endblock %}">
    {% block body %}{% endblock %}
</main>
{% block javascripts %}{% endblock %}
</body>
</html>
