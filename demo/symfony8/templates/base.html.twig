<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Maintenance Mode Demo{% endblock %}</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; background: #f4f6f8; color: #1a1a1a; }
        main { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1.25rem; }
        a { color: #0b5fff; }
        .card { background: #fff; border: 1px solid #ddd; border-radius: .75rem; padding: 1.25rem; margin-top: 1rem; }
    </style>
</head>
<body>
<main>
    {% block body %}{% endblock %}
</main>
</body>
</html>
