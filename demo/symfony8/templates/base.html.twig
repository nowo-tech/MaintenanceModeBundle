{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). It is also the host layout of the panel pages (nowo_ui_kit.layouts.admin).
    The header menu is static: the demo pages stay reachable (and cheap) while the site is in maintenance. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Maintenance Mode Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage') }}">Maintenance Mode Demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('homepage') }}">Home</a>
            <a class="nowo-ui-link" href="/_maintenance/">Admin panel</a>
            <a class="nowo-ui-link" href="/_maintenance/history">History</a>
            <a class="nowo-ui-link" href="/_maintenance_preview">503 preview</a>
            <a class="nowo-ui-link" href="{{ path('maintenance_examples') }}">Sample pages</a>
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
