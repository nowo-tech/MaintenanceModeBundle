{% extends 'base.html.twig' %}

{% block title %}Maintenance Mode Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Maintenance Mode Bundle',
        intro: 'FrankenPHP demo for nowo-tech/maintenance-mode-bundle.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'While maintenance is on', intro: 'The public 503 page must not send visitors to panel login. Use exclusions (or the auto-excluded /_maintenance prefix) to manage the site. Login itself is optional via YAML (security.password_protection).', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th>Page</th><th>What it shows</th></tr>
                </thead>
                <tbody>
                    <tr><td><a class="nowo-ui-link" href="/_maintenance_preview">Maintenance page preview</a></td><td class="nowo-ui-cell--wrap">The current maintenance page (dev, like <code class="nowo-ui-code">/_error/503</code>)</td></tr>
                    <tr><td><a class="nowo-ui-link" href="/_error/503">Symfony error page preview</a></td><td class="nowo-ui-cell--wrap"><code class="nowo-ui-code">/_error/503</code></td></tr>
                    <tr><td><a class="nowo-ui-link" href="/examples/bypass">Bypass guide</a></td><td class="nowo-ui-cell--wrap">Exclusion examples</td></tr>
                    <tr><td><a class="nowo-ui-link" href="/_maintenance/">Admin panel</a></td><td class="nowo-ui-cell--wrap">Login on when <code class="nowo-ui-code">password_protection: true</code>; password: <code class="nowo-ui-code">maintenance</code></td></tr>
                    <tr><td><a class="nowo-ui-link" href="/examples">Calm 503 page examples</a></td><td class="nowo-ui-cell--wrap">Bootstrap · Foundation · Tailwind · ideas</td></tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Quick exclusion smoke links', intro: 'Enable maintenance from the panel, then reload this page: you should get HTTP 503. The links below (and /examples/*) stay available.', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th>Kind</th><th>Try</th></tr>
                </thead>
                <tbody>
                    <tr><td>Path</td><td><a class="nowo-ui-link" href="/health"><code class="nowo-ui-code">/health</code></a></td></tr>
                    <tr><td>Route name</td><td><a class="nowo-ui-link" href="/status"><code class="nowo-ui-code">/status</code></a> (<code class="nowo-ui-code">app_status</code>)</td></tr>
                    <tr><td>Prefix</td><td><a class="nowo-ui-link" href="/api/ops/ping"><code class="nowo-ui-code">/api/ops/ping</code></a></td></tr>
                    <tr><td>Glob</td><td><a class="nowo-ui-link" href="/internal-check"><code class="nowo-ui-code">/internal-check</code></a></td></tr>
                    <tr><td>Regex</td><td><a class="nowo-ui-link" href="/ops/ready"><code class="nowo-ui-code">/ops/ready</code></a></td></tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
